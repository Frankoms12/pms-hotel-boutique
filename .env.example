# Configuración del stack local integrado. Copiar a .env (ignorado por Git).
# Completar proveedores con credenciales de desarrollo; nunca usar producción.
PMS_POSTGRES_PASSWORD=pms-local-development
# Compose fija el origen y callback local a 3001; este valor es para tooling standalone.
PMS_WEB_PUBLIC_URL=http://localhost:3001
# Los Route Handlers BFF usan http://backend:8080 dentro de Docker (Compose).
NEXT_PUBLIC_USE_MOCK_API=false

# DemoDataBootstrap crea staff.demo@example.test y guest.demo@example.test
# con password sintético PmsDemoLocal2026! SOLO dev/demo + flag.
# No usar estas cuentas/credenciales en producción.

# Para crear el primer SUPER_ADMIN, definir los tres valores solo en el despliegue.
# Nunca versionar estas credenciales ni un PMS_JWT_SECRET de producción.
PMS_JWT_SECRET=
PMS_RESERVATION_LINK_OTP_HMAC_KEY=
PMS_BOOTSTRAP_ADMIN_USERNAME=
PMS_BOOTSTRAP_ADMIN_EMAIL=
PMS_BOOTSTRAP_ADMIN_PASSWORD=

# Bootstrap opcional, sintético y SOLO para este stack local integrado.
# Para probar Staff, reemplazar arriba los tres valores vacíos con este bloque.
# No reutilizar esta contraseña fuera de local ni habilitarla en producción.
# PMS_BOOTSTRAP_ADMIN_USERNAME=local_staff
# PMS_BOOTSTRAP_ADMIN_EMAIL=local_staff@example.test
# PMS_BOOTSTRAP_ADMIN_PASSWORD=PMS-Local-Disposable-Only!2026

# Guest Google OIDC y Resend. Mantener vacíos en Docker local si no se prueba el proveedor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/guest/google/callback
# Provider: resend (default) or smtp. SMTP validates all PMS_SMTP_* at startup.
PMS_EMAIL_PROVIDER=resend
# Gmail QA: select smtp, host smtp.gmail.com, port 587; STARTTLS is mandatory.
PMS_SMTP_HOST=
PMS_SMTP_PORT=
PMS_SMTP_USERNAME=
PMS_SMTP_APP_PASSWORD=
PMS_SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Local Docker demo only. Application defaults remain disabled outside dev/demo profiles.
PMS_SPRING_PROFILES_ACTIVE=demo
PMS_DEMO_DATA_ENABLED=true
# NEXT_PUBLIC_PROPERTY_ID is supplied by Compose for the demo; override only for another Property.

NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_API_BASE_URL=
# Real public availability: existing active Property UUID (required at build time).
NEXT_PUBLIC_PROPERTY_ID=
# Server-only BFF transport; Compose supplies http://backend:8080.
# Solo con compose.debug.yaml para desarrollo standalone; Backend normal es interno.
PMS_BACKEND_INTERNAL_URL=http://localhost:8081
PMS_WEB_PUBLIC_URL=http://localhost:3001

{
  "info": {
    "name": "PMS BD2 — Staff Inventory",
    "description": "Login, scope y disponibilidad BD2. Requiere backend con migraciones BD3 y datos locales; ver backend/docs/14_BD2_TESTING_AND_POSTMAN.md. Credenciales/tokens solo en un environment privado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{staffAccessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18080"
    },
    {
      "key": "propertyId",
      "value": "3dcd0a8e-5c6a-46e7-8d51-7c95d86b232d"
    },
    {
      "key": "roomTypeId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "arrival",
      "value": "2026-11-01"
    },
    {
      "key": "departure",
      "value": "2026-11-03"
    },
    {
      "key": "unauthorizedPropertyId",
      "value": "00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "missingRoomTypeId",
      "value": "00000000-0000-4000-8000-000000000002"
    }
  ],
  "item": [
    {
      "name": "01 — Login Staff (201)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{staffEmail}}\",\"password\":\"{{staffPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/staff-auth/sessions",
        "description": "Login: email required, formato email, maxLength=50 tras trim/lowercase; password required/NotBlank, maxLength=50, intacta sin trim ni complejidad nueva. 51 caracteres o entrada inválida: HTTP400. Password writeOnly; no exportar credenciales/tokens reales."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Staff session created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.test('Access token returned', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
              "  pm.environment.set('staffAccessToken', body.accessToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Sesión y propiedades autorizadas (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/staff-auth/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Active Staff session', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('Scope and permissions returned', () => {",
              "    pm.expect(body.memberships).to.be.an('array');",
              "    pm.expect(body.permissions).to.be.an('array');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Disponibilidad (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/availability?roomTypeId={{roomTypeId}}&arrival={{arrival}}&departure={{departure}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Availability returned', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('Explicit IDs and nonnegative integer ATS', () => {",
              "    pm.expect(body.propertyId).to.equal(pm.variables.get('propertyId'));",
              "    pm.expect(body.roomTypeId).to.equal(pm.variables.get('roomTypeId'));",
              "    pm.expect(body.arrival).to.equal(pm.variables.get('arrival'));",
              "    pm.expect(body.departure).to.equal(pm.variables.get('departure'));",
              "    pm.expect(Number.isInteger(body.availableUnits)).to.equal(true);",
              "    pm.expect(body.availableUnits).to.be.at.least(0);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Sin token (401)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/availability?roomTypeId={{roomTypeId}}&arrival={{arrival}}&departure={{departure}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Missing token rejected', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Token inválido (401)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "invalid-token",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/availability?roomTypeId={{roomTypeId}}&arrival={{arrival}}&departure={{departure}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid token rejected', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 — Propiedad no autorizada (403)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/properties/{{unauthorizedPropertyId}}/availability?roomTypeId={{roomTypeId}}&arrival={{arrival}}&departure={{departure}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unauthorized property rejected', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 — Fechas iguales (400)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/availability?roomTypeId={{roomTypeId}}&arrival={{arrival}}&departure={{arrival}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid range rejected', () => pm.response.to.have.status(400));",
              "if (pm.response.code === 400) pm.test('ProblemDetail status', () => pm.expect(pm.response.json().status).to.equal(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 — Tipo inexistente en propiedad autorizada (404)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/availability?roomTypeId={{missingRoomTypeId}}&arrival={{arrival}}&departure={{departure}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unknown room type rejected', () => pm.response.to.have.status(404));",
              "if (pm.response.code === 404) pm.test('ProblemDetail status', () => pm.expect(pm.response.json().status).to.equal(404));"
            ]
          }
        }
      ]
    }
  ]
}
